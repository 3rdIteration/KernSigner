# SEC1210 UART smart-card reader bring-up overlay (Wave43 board).
#
# The live SEC1210 configuration previously existed only in the git-ignored
# `sdkconfig`, so a fresh checkout did not reproduce it. This overlay captures
# it in a tracked file. Layer it after the base and board defaults, deleting
# any existing `sdkconfig` first so the defaults are re-applied:
#
#   rm -f sdkconfig
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.wave_43;sdkconfig.defaults.sec1210" build
#
# It disables the PN5180 NFC reader (the wave_43 default leaves it enabled for
# other builds) and enables the SEC1210 serial CCID reader. The board's 40-pin
# header routes the hat's UART to GPIO2 (TX, to the reader's RXD) and GPIO5
# (RX, from the reader's TXD). Do NOT use GPIO37/GPIO38: those are the console
# U0TXD/U0RXD, shared with the USB-to-UART bridge and are boot strapping pins.

CONFIG_KSIG_BOARD_WAVE_43=y
# CONFIG_KSIG_PN5180_ENABLED is not set
CONFIG_KSIG_SEC1210_ENABLED=y
CONFIG_KSIG_SEC1210_UART_NUM=2
CONFIG_KSIG_SEC1210_UART_TX_PIN=2
CONFIG_KSIG_SEC1210_UART_RX_PIN=5
CONFIG_KSIG_SEC1210_UART_BAUDRATE=115200
